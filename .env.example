# asyncpg driver is required (SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5432/wallet
TEST_DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5432/wallet_test

# openssl rand -base64 32
JWT_SECRET=CHANGE_ME_dev_only_secret_do_not_ship
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AES-256 key, exactly 32 bytes, base64-encoded:  openssl rand -base64 32
PAYLOAD_AES_KEY=8pQ7yZ1kR4nV6bXcW2eT9uY0iO3aS5dF7gH8jK1lM4o=

# DEMO ONLY: exposes the AES key at GET /demo/crypto-key so the browser page can
# encrypt transfer payloads. MUST be false in production.
DEMO_MODE=true
